@startuml
' PlantUML Use Case Diagram for KryptUp Fintech Super-App
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam actorStyle Awesome
skinparam usecase {
    BackgroundColor #F9FAFB
    BorderColor #10B981
    FontName Arial
}

actor "App User / Investor" as User
actor "Android Keystore & Biometrics" as BiometricHW << Hardware >>
actor "Firebase Auth & Firestore" as Firebase << Cloud >>
actor "Ethereum / Sepolia Node" as Blockchain << Web3 >>
actor "Bank / UPI Switch" as BankSwitch << Banking >>
actor "Gemini AI Engine" as AI << AI Agent >>

rectangle "KryptUp Fintech Super-App System" {

    package "Authentication & Security" {
        usecase "UC1: Register & Login" as UC1
        usecase "UC2: Set Transaction PIN" as UC2
        usecase "UC3: Configure Facial Recognition" as UC3
        usecase "UC4: View Profile & Unique QR ID" as UC4
        usecase "UC5: Authorize Transaction\n(PIN / Face ID)" as UC5
    }

    package "Unified Fiat & UPI Banking" {
        usecase "UC6: Link Bank Account / Card" as UC6
        usecase "UC7: Verify 2FA OTP" as UC7
        usecase "UC8: Send P2P UPI Money" as UC8
        usecase "UC9: Scan QR Code (P2P Pay)" as UC9
    }

    package "Non-Custodial Web3 Crypto Vault" {
        usecase "UC10: Derive BIP-39 Seed & Address" as UC10
        usecase "UC11: Send Crypto (ETH / USDT)" as UC11
        usecase "UC12: Receive Crypto via Wallet QR" as UC12
    }

    package "Spot Trading Desk" {
        usecase "UC13: View Market Charts & Depth" as UC13
        usecase "UC14: Place Buy / Sell Spot Order" as UC14
    }

    package "AI Voice Assistant & Social DM" {
        usecase "UC15: Issue Voice/Text Financial Commands" as UC15
        usecase "UC16: Chat & Pay in DM Threads" as UC16
        usecase "UC17: Claim Daily APY Booster" as UC17
    }
}

' User Associations
User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC6
User --> UC8
User --> UC9
User --> UC11
User --> UC12
User --> UC13
User --> UC14
User --> UC15
User --> UC16
User --> UC17

' Include & Extend Relationships
UC8 ..> UC5 : <<include>>
UC11 ..> UC5 : <<include>>
UC14 ..> UC5 : <<include>>
UC6 ..> UC7 : <<include>>
UC9 ..> UC8 : <<extend>>
UC5 ..> UC3 : <<extend>>

' External Actor Connections
UC1 --> Firebase
UC4 --> Firebase
UC8 --> BankSwitch
UC6 --> BankSwitch
UC10 --> Blockchain
UC11 --> Blockchain
UC5 --> BiometricHW
UC15 --> AI

@enduml
